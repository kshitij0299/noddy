{
	"name": "noddy",
	"author": "Matt LaGrandeur",
	"version": "2.11.0-noddy.0",
	"license": "GPL-3.0-or-later",
	"homepage": "https://github.com/glyphr-studio/Glyphr-Studio-2#readme",
	"description": "Noddy — a friendly font editor, forked from Glyphr Studio 2.",
	"type": "module",
	"scripts": {
		"dev": "run-func scripts.js dev && vite serve ./src/",
		"build": "run-func scripts.js build  && vite build ./src/ --emptyOutDir --base=/app/",
		"stage": "run-func scripts.js stage  && vite build ./src/ --emptyOutDir --base=/staged/",
		"test": "vitest watch",
		"coverage": "vitest watch --silent=true --coverage",
		"lint": "eslint src",
		"fix": "eslint src --fix",
		"ci:versions": "node scripts/check-versions.mjs",
		"agent:serve": "node server/agent/serve.js",
		"models:snapshot": "node scripts/build-model-snapshot.mjs",
		"test:agent-relay": "node --test server/agent/*.checks.js",
		"typecheck:agent-relay": "tsc -p server/agent/tsconfig.json"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@types/jest": "^29.5.12",
		"@vitest/browser": "^4.1.10",
		"buffer": "^6.0.3",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-prettier": "^4.2.1",
		"globals": "^17.6.0",
		"jsdom": "^24.0.0",
		"lit": "^3.1.4",
		"prettier": "^2.7.1",
		"run-func": "^3.0.0",
		"svg-to-bezier": "^2.3.0",
		"typescript-eslint": "^8.61.1",
		"vi-canvas-mock": "^1.0.0",
		"vite": ">=7.3.2",
		"vitest": "^4.1.10"
	},
	"bugs": {
		"url": "https://github.com/glyphr-studio/Glyphr-Studio-2/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/glyphr-studio/Glyphr-Studio-2.git"
	},
	"prettier": {
		"printWidth": 100,
		"trailingComma": "es5",
		"singleQuote": true,
		"useTabs": true,
		"arrowParens": "always"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.71",
		"@ai-sdk/openai": "^4.0.83",
		"@ai-sdk/openai-compatible": "^3.0.62",
		"@mattlag/xmltojson": "^2.0.2",
		"ai": "^7.0.127",
		"bezier-boolean": "^1.0.6",
		"eslint": "^10.8.0",
		"font-flux-js": "^2.7.1",
		"paper": "0.12.18"
	},
	"engines": {
		"node": ">=22"
	}
}
